# bedrockproxy configuration. Copy to /etc/bedrockproxy/bedrockproxy.env and edit.
# After editing: sudo systemctl restart bedrockproxy

# ---- Transport ----
# New installations default to NetherNet. Set PROTOCOL=raknet for LAN/DNS relay.
PROTOCOL=nethernet

# ---- Upstream ----
# In RakNet mode: host:port. In NetherNet mode: http(s)://host:port base,
# or a bare host:port (interpreted as http://host:port).
REMOTE=
# Optional explicit NetherNet signaling URL. Blank uses REMOTE.
REMOTE_SIGNAL_URL=
# UDP media relay uses a separate ephemeral port per session. These are the proxy's local-facing and upstream-facing IPv4
# addresses, not the remote server's addresses. Required in NetherNet mode.
MEDIA_BIND=:0
MEDIA_CLIENT_ADDRESS=
MEDIA_UPSTREAM_ADDRESS=
# Name shown in the server list; blank mirrors the remote server.
MOTD=Adventure Server
# Bind address. RakNet uses UDP; NetherNet uses TCP signaling.
BIND=:19132

# ---- Switch DNS mode (optional) ----
# To reach Nintendo Switch, the proxy must answer DNS for the Bedrock "featured
# server" hostnames so a Switch connecting to one is relayed to REMOTE.
# RakNet only: set DNS_LISTEN to :53 to enable; leave empty to disable.
DNS_LISTEN=
# IP returned for pinned domains (the proxy's LAN IP). Blank = auto-detect.
DNS_TARGET_IP=
# Upstream resolver for everything else (keeps the rest of the LAN working).
DNS_UPSTREAM=1.1.1.1:53
# Two ways to point Switches at this DNS:
#   per-Switch: set each Switch's primary DNS to this box's IP (secondary 1.1.1.1)
#   LAN-wide:   set the router/DHCP DNS to this box (zero per-Switch config)
